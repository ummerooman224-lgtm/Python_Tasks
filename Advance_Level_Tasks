        "# Task 11: Expense Tracker\n",
        "\n",
        "expenses_list = []\n",
        "\n",
        "total_expenses = int(input(\"How many expenses do you want to enter? \"))\n",
        "for i in range(total_expenses):\n",
        "    print(f\"\\n--- Expense #{i + 1} ---\")\n",
        "\n",
        "    name = input(\"Enter Expense Name: \")\n",
        "    category = input(\"Category (Food/Transport/Shopping/Bills/Other): \")\n",
        "    amount = float(input(\"Enter Amount: \"))\n",
        "\n",
        "    expense_dict = {\n",
        "        \"name\": name,\n",
        "        \"category\": category,\n",
        "        \"amount\": amount\n",
        "    }\n",
        "\n",
        "    expenses_list.append(expense_dict)\n",
        "\n",
        "total_spending = 0\n",
        "\n",
        "for expense in expenses_list:\n",
        "    total_spending += expense[\"amount\"]\n",
        "\n",
        "category_spending = {}\n",
        "\n",
        "for expense in expenses_list:\n",
        "    category = expense[\"category\"]\n",
        "    amount = expense[\"amount\"]\n",
        "\n",
        "    if category in category_spending:\n",
        "        category_spending[category] += amount\n",
        "    else:\n",
        "        category_spending[category] = amount\n",
        "\n",
        "highest_expense = max(expenses_list, key=lambda expense: expense[\"amount\"])\n",
        "\n",
        "budget = float(input(\"\\nEnter your budget: \"))\n",
        "\n",
        "if total_spending > budget:\n",
        "    print(\"\\nWARNING: You have exceeded your budget!\")\n",
        "else:\n",
        "    print(\"\\nYou are within your budget.\")\n",
        "\n",
        "def final_report():\n",
        "    print(\"\\n========== FINAL REPORT ==========\")\n",
        "    print(\"Total Spending:\", total_spending)\n",
        "    print(\"Budget:\", budget)\n",
        "\n",
        "    print(\"\\n--- Category Wise Spending ---\")\n",
        "    for category, amount in category_spending.items():\n",
        "        print(category, \":\", amount)\n",
        "\n",
        "    print(\"\\n--- Highest Expense ---\")\n",
        "    print(\"Name:\", highest_expense[\"name\"])\n",
        "    print(\"Category:\", highest_expense[\"category\"])\n",
        "    print(\"Amount:\", highest_expense[\"amount\"])\n",
        "\n",
        "final_report()"
      ]
    },
