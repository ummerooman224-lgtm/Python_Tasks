        "# Task 15: Clinic Appointment Manager\n",
        "patients = []\n",
        "\n",
        "def add_patient():\n",
        "  patient_id = int(input(\"Enter your ID: \"))\n",
        "  for patient in patients:\n",
        "    if patient[\"id\"] == patient_id:\n",
        "      print(\"Patient already exists\")\n",
        "      return\n",
        "  patient_name = input(\"Enter patient name: \")\n",
        "  patient_age = int(input(\"Enter patient age: \"))\n",
        "  problem = input(\"Enter patient problem: \")\n",
        "  time = int(input(\"Enter appointment time: \"))\n",
        "  emergency = input(\"Is this an emergency patient? yes/no: \")\n",
        "\n",
        "  patients.append({\n",
        "    \"id\": patient_id,\n",
        "    \"name\": patient_name,\n",
        "    \"age\": patient_age,\n",
        "    \"problem\": problem,\n",
        "    \"time\": time,\n",
        "    \"emergency\": emergency\n",
        "  })\n",
        "\n",
        "def search_patient():\n",
        "  patient_id = int(input(\"Enter patient ID: \"))\n",
        "  for patient in patients:\n",
        "    if patient[\"id\"] == patient_id:\n",
        "      print(\"Patient found\")\n",
        "      print(f'Patient name: {patient[\"name\"]}')\n",
        "      print(f'Patient age: {patient[\"age\"]}')\n",
        "      print(f'Patient problem: {patient[\"problem\"]}')\n",
        "      print(f'Patient time: {patient[\"time\"]}')\n",
        "      print(f'Patient emergency: {patient[\"emergency\"]}')\n",
        "      return\n",
        "  print(\"Patient not found\")\n",
        "\n",
        "def display_appointment():\n",
        "  print(\"========== Emergency Patient ==========\")\n",
        "  for patient in patients:\n",
        "    if patient[\"emergency\"] == \"yes\":\n",
        "      print(f'Patient name: {patient[\"name\"]}')\n",
        "      print(f'Patient age: {patient[\"age\"]}')\n",
        "      print(f'Patient problem: {patient[\"problem\"]}')\n",
        "      print(f'Patient time: {patient[\"time\"]}')\n",
        "\n",
        "  print(\"========== Normal Patient ==========\")\n",
        "  for patient in patients:\n",
        "    if patient[\"emergency\"] == \"no\":\n",
        "      print(f'Patient name: {patient[\"name\"]}')\n",
        "      print(f'Patient age: {patient[\"age\"]}')\n",
        "      print(f'Patient problem: {patient[\"problem\"]}')\n",
        "      print(f'Patient time: {patient[\"time\"]}')\n",
        "\n",
        "def delete_patient():\n",
        "  patient_id = int(input(\"Enter patient ID: \"))\n",
        "  for patient in patients:\n",
        "    if patient[\"id\"] == patient_id:\n",
        "      patients.remove(patient)\n",
        "      print(\"Patient deleted\")\n",
        "      return\n",
        "  print(\"Patient not found\")\n",
        "\n",
        "def count_patient():\n",
        "  emergency_count = 0\n",
        "  normal_count = 0\n",
        "  for patient in patients:\n",
        "    if patient[\"emergency\"] == \"yes\":\n",
        "      emergency_count += 1\n",
        "    else:\n",
        "      normal_count += 1\n",
        "  print(f\"Emergency Patients: {emergency_count}\")\n",
        "  print(f\"Normal Patients: {normal_count}\")\n",
        "\n",
        "while True:\n",
        "  print(\"\\n1. Add patient\")\n",
        "  print(\"2. Search patient\")\n",
        "  print(\"3. Display appointment\")\n",
        "  print(\"4. Delete patient\")\n",
        "  print(\"5. Count patient\")\n",
        "  print(\"6. Exit\")\n",
        "\n",
        "  choice = int(input(\"Enter your choice: \"))\n",
        "\n",
        "  if choice == 1:\n",
        "    add_patient()\n",
        "  elif choice == 2:\n",
        "    search_patient()\n",
        "  elif choice == 3:\n",
        "    display_appointment()\n",
        "  elif choice == 4:\n",
        "    delete_patient()\n",
        "  elif choice == 5:\n",
        "    count_patient()\n",
        "  elif choice == 6:\n",
        "    break\n",
        "  else:\n",
        "    print(\"Invalid choice\")"
