        "# Task 12: Store Inventory\n",
        "\n",
        "products = {}\n",
        "\n",
        "def add_product():\n",
        "    name = input(\"Product Name: \")\n",
        "    price = float(input(\"Price: \"))\n",
        "    quantity = int(input(\"Quantity: \"))\n",
        "\n",
        "    products[name] = {\n",
        "        \"price\": price,\n",
        "        \"quantity\": quantity\n",
        "    }\n",
        "\n",
        "    print(\"Product added successfully.\")\n",
        "\n",
        "\n",
        "def sell_product():\n",
        "    name = input(\"Product Name: \")\n",
        "    quantity = int(input(\"Quantity to sell: \"))\n",
        "\n",
        "    if name in products:\n",
        "        if products[name][\"quantity\"] >= quantity:\n",
        "            products[name][\"quantity\"] -= quantity\n",
        "            print(\"Product sold successfully.\")\n",
        "        else:\n",
        "            print(\"WARNING: Insufficient stock.\")\n",
        "    else:\n",
        "        print(\"Product not found.\")\n",
        "\n",
        "\n",
        "def restock_product():\n",
        "    name = input(\"Product Name: \")\n",
        "    quantity = int(input(\"Quantity to add: \"))\n",
        "\n",
        "    if name in products:\n",
        "        products[name][\"quantity\"] += quantity\n",
        "        print(\"Product restocked successfully.\")\n",
        "    else:\n",
        "        print(\"Product not found.\")\n",
        "\n",
        "\n",
        "def search_product():\n",
        "    name = input(\"Product Name: \")\n",
        "\n",
        "    if name in products:\n",
        "        print(\"Product:\", name)\n",
        "        print(\"Price:\", products[name][\"price\"])\n",
        "        print(\"Quantity:\", products[name][\"quantity\"])\n",
        "    else:\n",
        "        print(\"Product not found.\")\n",
        "\n",
        "\n",
        "def display_inventory():\n",
        "    print(\"\\n--- Inventory ---\")\n",
        "\n",
        "    total_value = 0\n",
        "\n",
        "    for name, product in products.items():\n",
        "        price = product[\"price\"]\n",
        "        quantity = product[\"quantity\"]\n",
        "        value = price * quantity\n",
        "\n",
        "        print(name, \"| Price:\", price, \"| Quantity:\", quantity, \"| Value:\", value)\n",
        "\n",
        "        total_value += value\n",
        "\n",
        "    print(\"Total Inventory Value:\", total_value)\n",
        "\n",
        "    print(\"\\n--- Low Stock Products ---\")\n",
        "\n",
        "    for name, product in products.items():\n",
        "        if product[\"quantity\"] < 5:\n",
        "            print(name, \"| Quantity:\", product[\"quantity\"])\n",
        "\n",
        "\n",
        "while True:\n",
        "    print(\"\\n1. Add Product\")\n",
        "    print(\"2. Sell Product\")\n",
        "    print(\"3. Restock Product\")\n",
        "    print(\"4. Search Product\")\n",
        "    print(\"5. Display Inventory\")\n",
        "    print(\"6. Exit\")\n",
        "\n",
        "    choice = input(\"Enter your choice: \")\n",
        "\n",
        "    if choice == \"1\":\n",
        "        add_product()\n",
        "    elif choice == \"2\":\n",
        "        sell_product()\n",
        "    elif choice == \"3\":\n",
        "        restock_product()\n",
        "    elif choice == \"4\":\n",
        "        search_product()\n",
        "    elif choice == \"5\":\n",
        "        display_inventory()\n",
        "    elif choice == \"6\":\n",
        "        print(\"Program ended.\")\n",
        "        break\n",
        "    else:\n",
        "        print(\"Invalid choice.\")"
      ],
